# GitHub Personal Access Tokens (separate multiple tokens with commas)
GITHUB_TOKENS=ghp_token1_here,ghp_token2_here,ghp_token3_here

# GitLab Personal Access Tokens (separate multiple tokens with commas)
GITLAB_TOKENS=glpat_token1_here,glpat_token2_here

# GitLab URL (optional, defaults to https://gitlab.com)
GITLAB_URL=https://gitlab.com

# Optional: Enable debug mode
DEBUG=false

# Optional: Default search parameters
DEFAULT_GITHUB_PAGES=5
DEFAULT_GITLAB_PROJECTS=25
DEFAULT_SEARCH_RECENT=true
